{%- comment -%}
  Canonical producer alias table - the single source of truth for which tags
  belong to a producer. Built once here so Search's producer checkboxes, its
  visible-query cleanup, and the Article Index all resolve a producer to the
  same tag set. Each definition is:

    Label::handleized id::tag1~tag2~tag3

  Tags are the canonical label, its legacy suffix-stripped form ("The ",
  " Distillery", " Brewery" and friends), the Macallan special case, and any
  aliases from the producer extensions above. The handle is precomputed with
  Liquid's own handleize so consumers never have to reimplement it.
{%- endcomment -%}
{% assign editorial_producer_alias_producers = editorial_search_browse_producers_string | split: '|' %}
{% assign editorial_producer_alias_extensions_lookup = '|' | append: editorial_article_index_producer_extensions_string %}
{% assign editorial_producer_alias_definitions_string = '' %}
{% for editorial_producer_alias_producer in editorial_producer_alias_producers %}
  {% assign editorial_producer_alias_tags = editorial_producer_alias_producer %}
  {% assign editorial_producer_alias_stripped = editorial_producer_alias_producer | remove_first: 'The ' | remove: ' Distillery' | remove: ' Distillerie' | remove: ' Brewery' | remove: ' Brewing' | remove: ' Inc.' | remove: ' Inc' | strip %}
  {% if editorial_producer_alias_stripped != editorial_producer_alias_producer %}
    {% assign editorial_producer_alias_tags = editorial_producer_alias_tags | append: '~' | append: editorial_producer_alias_stripped %}
  {% endif %}
  {% if editorial_producer_alias_producer == 'The Macallan' %}
    {% assign editorial_producer_alias_tags = editorial_producer_alias_tags | append: '~Macallan Distillery' %}
  {% endif %}
  {%- comment -%}
    Extension lookup by marker split, so this stays one pass over the producer
    list instead of a nested loop over every extension entry.
  {%- endcomment -%}
  {% capture editorial_producer_alias_marker %}|{{ editorial_producer_alias_producer }}::{% endcapture %}
  {% if editorial_producer_alias_extensions_lookup contains editorial_producer_alias_marker %}
    {% assign editorial_producer_alias_after_marker = editorial_producer_alias_extensions_lookup | split: editorial_producer_alias_marker %}
    {% assign editorial_producer_alias_extension_tags = editorial_producer_alias_after_marker[1] | split: '|' | first %}
    {% assign editorial_producer_alias_tags = editorial_producer_alias_tags | append: '~' | append: editorial_producer_alias_extension_tags %}
  {% endif %}
  {% assign editorial_producer_alias_handle = editorial_producer_alias_producer | handleize %}
  {% capture editorial_producer_alias_definition %}{{ editorial_producer_alias_producer }}::{{ editorial_producer_alias_handle }}::{{ editorial_producer_alias_tags }}{% endcapture %}
  {% if editorial_producer_alias_definitions_string == '' %}
    {% assign editorial_producer_alias_definitions_string = editorial_producer_alias_definition %}
  {% else %}
    {% assign editorial_producer_alias_definitions_string = editorial_producer_alias_definitions_string | append: '|' | append: editorial_producer_alias_definition %}
  {% endif %}
{% endfor %}
