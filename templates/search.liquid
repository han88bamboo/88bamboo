{% assign editorial_search_filter_tags_string = "Section: Books|Section: DuRhum Rum Reviews|Section: Rhythm and Booze|Section: Bottoms Up|Section: 88 Bamboo Japan|Section: 88 Bamboo Hong Kong|Section: 88 Bamboo Taiwan|Section: 88 Bamboo Philippines|Section: 88 Bamboo Thailand|Section: 88 Bamboo Vietnam|Section: 88 Bamboo Indonesia|Section: 88 Bamboo Korea|Section: Japanese Whisky Dictionary|Section: Sku's Drinks|Section: Sicklehut|Section: SG Alcohol Guy|Section: Prints|Section: TV" %}
{% assign editorial_search_filter_tags = editorial_search_filter_tags_string | split: '|' %}
{% assign editorial_search_browse_section_definitions_string = "News::Section: News|Feature::Section: Feature|Interview::Section: Interview|Deep Dive::Section: Deep Dive|Review::Section: Review" %}
{% assign editorial_search_browse_drink_definitions_string = "Beer::Beer|Gin::Gin|Rum::Rum|Sake::Sake|Tequila & Mezcal::Tequila~Mezcal|Whisky::Whisky|Wine::Wine|Other Drinks::Other Drinks" %}
{% assign editorial_search_browse_country_definitions_string = "USA::USA~US~America|UK (incl Scotland)::UK~United Kingdom~England~Scotland|Ireland::Ireland|France::France|Australia::Australia|Germany::Germany|Japan::Japan|Korea::Korea|China::China|Taiwan::Taiwan|Italy::Italy|Philippines::Philippines|Hungary::Hungary" %}
{% assign editorial_search_browse_producers_string = "1800 Tequila|Aberlour|Akita Jozo|Amabuki Shuzo|Amrut|Antelope|Ardbeg|Arette|Asahi|Asahi Shuzo|Atelier Guibert|Ballantine's|Bardstown|Bielle|Big Kahuna|Black Tot|Blackadder|Bonifacio|Bowmore|Brauerei Weihenstephan|Brooklyn Kura|Brown-Forman|Brugal|Bruichladdich|Byeolsan|Cairns Rum Company|Camus|Cascahuín|Champagne Palmer|Chichibu|Chivas Brothers|Chivas Regal|Clumzy Plumzy|Coyote Sotol|Craftbros|Dalho|Danong Bio|Dassai|Dassai Blue|Delamotte|Devanom|Diageo|Domaine de la Gyalthang|Domaine Pierre Damoy|Don Julio|Edrington|Elixir Distillers|Eminente|Estrella Damm|FAIR|Fattoria da Sasino|Fireball|Four Pillars Gin|Foursquare|G4 Tequila|Gaja|Gamuchi Soju|Glenfiddich|Glengoyne|Gordon & MacPhail|Gordon's|Gran Centenario|Great Northern Distillery|Grey Goose|haccoba|Hakushu|Hampden|Hana Makgeolli|Hendrick's|Hennessy|Henri Giraud|Hibiki|Hiraroku|Hwasim Jujo|Il Borro|Isautier|IWA 5 Sake|Iyoshi Cola|Jack Daniel's|Jiran Jigyo|Jose Cuervo|Kanosuke|Karuizawa|Kasa Kana|Kavalan|Kimchangsoo|Koch|Lark|Leeu Passant|LIBROM|Longmorn|Luisita|Maestro Dobel|Mas de Daumas Gassac|Masahiro|Minenohakubai Shuzo|Miyagikyo|Miyazaki Hideji|Moon Import|Mullineux|Nagura|Newton Johnson|Niigata Kameda|Nikka Whisky|Ninefold|Nobilis|nondo|Old Forester|Onzi Suldoga|Patron|Penfolds|Pernod Ricard|Pierre-Yves Colin-Morey (PYCM)|Podere Il Carnasciale|Renais Gin|Roederer Group|Roku Gin|Ron Zacapa|Royal Salute|Saburomaru|Sakari (Nihonsakari)|Sakurao|Samata Brewing|Sapporo|Savanna|Sazerac|Seochon Makgeolli|Shimazaki Shuzo|Sipsmith|Sula|Sullivans Cove|Suntory|Suntory Premium Malt's|Swell de Spirits|Szepsy|Taketsuru|Tatenokawa|TDL|Tenuta Pinino|Terada Honke|The Bruery|The Glenlivet|The Macallan|The Whisky Jury|Togouchi|Toki|Tormore|Tsingtao|Velier|Weightstone|Weingut Keller|Wild Turkey|Xiao Ling|Xiaopu|Yamazaki|Yangjudoga|Yoshida Denzai|Yuki No Bijin|Zephyr Wines" %}
{% assign editorial_search_browse_section_definitions = editorial_search_browse_section_definitions_string | split: '|' %}
{% assign editorial_search_browse_drink_definitions = editorial_search_browse_drink_definitions_string | split: '|' %}
{% assign editorial_search_browse_country_definitions = editorial_search_browse_country_definitions_string | split: '|' %}
{% assign editorial_search_browse_producers = editorial_search_browse_producers_string | split: '|' %}

{% assign editorial_search_browse_cleanup_tags_string = '' %}
{% assign editorial_search_browse_definition_groups = editorial_search_browse_section_definitions_string | append: '|' | append: editorial_search_browse_drink_definitions_string | append: '|' | append: editorial_search_browse_country_definitions_string | split: '|' %}
{% for editorial_search_browse_definition in editorial_search_browse_definition_groups %}
  {% assign editorial_search_browse_definition_parts = editorial_search_browse_definition | split: '::' %}
  {% assign editorial_search_browse_definition_tags = editorial_search_browse_definition_parts[1] | split: '~' %}
  {% for editorial_search_browse_definition_tag in editorial_search_browse_definition_tags %}
    {% assign editorial_search_browse_cleanup_tags_string = editorial_search_browse_cleanup_tags_string | append: '|' | append: editorial_search_browse_definition_tag %}
  {% endfor %}
{% endfor %}
{% for editorial_search_browse_producer in editorial_search_browse_producers %}
  {% assign editorial_search_browse_producer_alias = editorial_search_browse_producer | remove_first: 'The ' | remove: ' Distillery' | remove: ' Brewery' | remove: ' Brewing' | remove: ' Inc.' | remove: ' Inc' | strip %}
  {% assign editorial_search_browse_cleanup_tags_string = editorial_search_browse_cleanup_tags_string | append: '|' | append: editorial_search_browse_producer %}
  {% if editorial_search_browse_producer_alias != editorial_search_browse_producer %}
    {% assign editorial_search_browse_cleanup_tags_string = editorial_search_browse_cleanup_tags_string | append: '|' | append: editorial_search_browse_producer_alias %}
  {% endif %}
  {% if editorial_search_browse_producer == 'The Macallan' %}
    {% assign editorial_search_browse_cleanup_tags_string = editorial_search_browse_cleanup_tags_string | append: '|Macallan Distillery' %}
  {% endif %}
{% endfor %}

{% assign editorial_search_cleanup_tags_string = editorial_search_filter_tags_string | append: '|Panda Press' | append: editorial_search_browse_cleanup_tags_string %}
{% assign editorial_search_cleanup_tags = editorial_search_cleanup_tags_string | split: '|' %}
{% assign normalized_search_terms = search.terms | replace: '&amp;quot;', '"' | replace: '&quot;', '"' | replace: '&#34;', '"' | replace: '&#x22;', '"' | replace: '&apos;', "'" | replace: '&#39;', "'" | replace: '&#x27;', "'" %}
{% assign editorial_search_browse_cleanup_tags = editorial_search_browse_cleanup_tags_string | split: '|' %}
{% assign editorial_search_query_segments = normalized_search_terms | split: ' AND ' %}
{% assign visible_search_terms_with_spacing = '' %}
{% assign editorial_search_browse_suffix_started = false %}
{% for editorial_search_query_segment in editorial_search_query_segments %}
  {% assign editorial_search_segment_has_browse_inclusion = false %}
  {% for editorial_search_browse_tag in editorial_search_browse_cleanup_tags %}
    {% if editorial_search_browse_tag != blank %}
      {% capture editorial_search_browse_inclusion %}tag:"{{ editorial_search_browse_tag }}"{% endcapture %}
      {% capture editorial_search_browse_exclusion %}-tag:"{{ editorial_search_browse_tag }}"{% endcapture %}
      {% assign editorial_search_segment_without_browse_exclusion = editorial_search_query_segment | replace: editorial_search_browse_exclusion, ' ' %}
      {% if editorial_search_segment_without_browse_exclusion contains editorial_search_browse_inclusion %}
        {% assign editorial_search_segment_has_browse_inclusion = true %}
      {% endif %}
    {% endif %}
  {% endfor %}
  {% if editorial_search_segment_has_browse_inclusion %}
    {% assign editorial_search_browse_suffix_started = true %}
  {% endif %}
  {% unless editorial_search_browse_suffix_started %}
    {% if visible_search_terms_with_spacing == blank %}
      {% assign visible_search_terms_with_spacing = editorial_search_query_segment %}
    {% else %}
      {% assign visible_search_terms_with_spacing = visible_search_terms_with_spacing | append: ' AND ' | append: editorial_search_query_segment %}
    {% endif %}
  {% endunless %}
{% endfor %}
{% for editorial_search_filter_tag in editorial_search_cleanup_tags %}
  {% capture editorial_search_exclusion %}-tag:"{{ editorial_search_filter_tag }}"{% endcapture %}
  {% assign visible_search_terms_with_spacing = visible_search_terms_with_spacing | replace: editorial_search_exclusion, ' ' %}
{% endfor %}
{% assign visible_search_terms = '' %}
{% assign visible_search_term_parts = visible_search_terms_with_spacing | split: ' ' %}
{% for visible_search_term_part in visible_search_term_parts %}
  {% if visible_search_term_part != blank %}
    {% if visible_search_terms == blank %}
      {% assign visible_search_terms = visible_search_term_part %}
    {% else %}
      {% assign visible_search_terms = visible_search_terms | append: ' ' | append: visible_search_term_part %}
    {% endif %}
  {% endif %}
{% endfor %}

{% paginate search.results by 45 %}

<div class="page-width">
  {% if search.performed == false %}
    <div class="text-center">
      <h1 class="h2">{{ 'general.search.title' | t }}</h1>
  {% else %}
    <div class="text-center">
      <h1 class="h2">
        {% comment %}
          Search terms are intentionally omitted here so internal Shopify query
          syntax is never presented in the visible results heading.
          <span class="visually-hidden">{{ 'general.search.heading' | t: count: search.results_count }}:</span>
          {{ 'general.search.results_with_count' | t: terms: visible_search_terms, count: search.results_count }}
        {% endcomment %}
        {{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %}
      </h1>
  {% endif %}
      <div class="grid">
        <div class="grid__item medium-up--six-tenths medium-up--push-two-tenths">
          {% if search.performed and search.results_count == 0 %}
            <div class="rte search--no-results-found">
              <p>{{ 'general.search.no_results' | t }}</p>
            </div>
          {% endif %}
          <form
            id="SearchPageForm"
            action="{{ routes.search_url }}"
            method="get"
            role="search"
            class="search-form search-page-form"
            data-editorial-search-form
          >
            <input
              type="hidden"
              name="q"
              value="{{ normalized_search_terms | escape }}"
              data-editorial-search-shopify-query
            />
            <input type="hidden" name="type" value="article" aria-hidden="true" />
            <input
              type="hidden"
              name="browse_open"
              value="none"
              data-editorial-search-browse-open-state
            />
            <div class="input-group input-group--nowrap">
              <div class="input-group__field input-group__field--connected search-form__input-wrapper">
                <input
                  type="search"
                  value="{{ visible_search_terms | escape }}"
                  placeholder="{{ 'general.search.placeholder' | t }}"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-owns="predictive-search-results"
                  aria-expanded="false"
                  aria-label="{{ 'general.search.placeholder' | t }}"
                  aria-haspopup="listbox"
                  class="search-form__input"
                  data-search-page-predictive-search-input
                  data-editorial-search-visible-query
                />

                <input type="hidden" name="options[prefix]" value="last" aria-hidden="true" />

                <button type="reset" class="search-form__clear-action" aria-label="{{ 'general.search.clear_search_term' | t }}" data-search-page-predictive-search-clear>
                  {% render 'icon-close' %}
                </button>

                <div class="predictive-search-wrapper" data-predictive-search-mount="default"></div>
              </div>

              <button type="submit" class="search-form__connected-submit" aria-label="{{ 'general.search.submit' | t }}" data-search-page-predictive-search-submit>
                {% render 'icon-search' %}
              </button>
            </div>
          </form>
        </div>
      </div>
  </div>
</div>


{% if search.performed %}
  {% if search.results_count > 0 %}
    <hr aria-hidden="true" />
  {% endif %}

  <h2 class="visually-hidden">{{ 'general.search.heading' | t: count: search.results_count }}</h2>

  <div class="page-width search-page-results-layout">
    <aside class="search-page-filters-column" aria-label="Search result filters">
      <details class="search-page-filters search-page-browse" open data-editorial-search-browse-panel>
        <summary class="search-page-filters__summary">
          <span>Browse</span>
        </summary>
        <div class="search-page-browse__content">
          <div class="search-page-browse__toolbar">
            <button type="button" class="search-page-browse__clear" data-editorial-search-browse-clear disabled>
              Clear
            </button>
          </div>

          <details class="search-page-browse__group" data-editorial-search-browse-group="section">
            <summary class="search-page-browse__group-summary" data-editorial-search-browse-group-summary>
              <span>Section</span>
            </summary>
            <fieldset class="search-page-browse__group-content">
              <legend class="visually-hidden">Browse by section</legend>
              <div class="search-page-filters__options">
                {% for editorial_search_browse_definition in editorial_search_browse_section_definitions %}
                  {% assign editorial_search_browse_definition_parts = editorial_search_browse_definition | split: '::' %}
                  {% assign editorial_search_browse_label = editorial_search_browse_definition_parts[0] %}
                  {% assign editorial_search_browse_tags = editorial_search_browse_definition_parts[1] %}
                  {% assign editorial_search_browse_id = editorial_search_browse_label | handleize | prepend: 'SearchBrowse-section-' %}
                  <div class="search-page-filters__option">
                    <input
                      id="{{ editorial_search_browse_id }}"
                      type="checkbox"
                      class="search-page-filters__checkbox"
                      data-editorial-search-browse-filter
                      data-editorial-search-browse-group-name="section"
                      data-editorial-search-browse-tags="{{ editorial_search_browse_tags | escape }}"
                      form="SearchPageForm"
                    />
                    <label for="{{ editorial_search_browse_id }}">{{ editorial_search_browse_label }}</label>
                  </div>
                {% endfor %}
              </div>
            </fieldset>
          </details>

          <details class="search-page-browse__group" data-editorial-search-browse-group="drink-type">
            <summary class="search-page-browse__group-summary" data-editorial-search-browse-group-summary>
              <span>Drink Type</span>
            </summary>
            <fieldset class="search-page-browse__group-content">
              <legend class="visually-hidden">Browse by drink type</legend>
              <div class="search-page-filters__options">
                {% for editorial_search_browse_definition in editorial_search_browse_drink_definitions %}
                  {% assign editorial_search_browse_definition_parts = editorial_search_browse_definition | split: '::' %}
                  {% assign editorial_search_browse_label = editorial_search_browse_definition_parts[0] %}
                  {% assign editorial_search_browse_tags = editorial_search_browse_definition_parts[1] %}
                  {% assign editorial_search_browse_id = editorial_search_browse_label | handleize | prepend: 'SearchBrowse-drink-' %}
                  <div class="search-page-filters__option">
                    <input
                      id="{{ editorial_search_browse_id }}"
                      type="checkbox"
                      class="search-page-filters__checkbox"
                      data-editorial-search-browse-filter
                      data-editorial-search-browse-group-name="drink-type"
                      data-editorial-search-browse-tags="{{ editorial_search_browse_tags | escape }}"
                      form="SearchPageForm"
                    />
                    <label for="{{ editorial_search_browse_id }}">{{ editorial_search_browse_label }}</label>
                  </div>
                {% endfor %}
              </div>
            </fieldset>
          </details>

          <details class="search-page-browse__group" data-editorial-search-browse-group="country">
            <summary class="search-page-browse__group-summary" data-editorial-search-browse-group-summary>
              <span>Country</span>
            </summary>
            <fieldset class="search-page-browse__group-content">
              <legend class="visually-hidden">Browse by country</legend>
              <div class="search-page-filters__options">
                {% for editorial_search_browse_definition in editorial_search_browse_country_definitions %}
                  {% assign editorial_search_browse_definition_parts = editorial_search_browse_definition | split: '::' %}
                  {% assign editorial_search_browse_label = editorial_search_browse_definition_parts[0] %}
                  {% assign editorial_search_browse_tags = editorial_search_browse_definition_parts[1] %}
                  {% assign editorial_search_browse_id = editorial_search_browse_label | handleize | prepend: 'SearchBrowse-country-' %}
                  <div class="search-page-filters__option">
                    <input
                      id="{{ editorial_search_browse_id }}"
                      type="checkbox"
                      class="search-page-filters__checkbox"
                      data-editorial-search-browse-filter
                      data-editorial-search-browse-group-name="country"
                      data-editorial-search-browse-tags="{{ editorial_search_browse_tags | escape }}"
                      form="SearchPageForm"
                    />
                    <label for="{{ editorial_search_browse_id }}">{{ editorial_search_browse_label }}</label>
                  </div>
                {% endfor %}
              </div>
            </fieldset>
          </details>

          <details class="search-page-browse__group" data-editorial-search-browse-group="producer">
            <summary class="search-page-browse__group-summary" data-editorial-search-browse-group-summary>
              <span>Producer</span>
            </summary>
            <fieldset class="search-page-browse__group-content">
              <legend class="visually-hidden">Browse by producer</legend>
              <div class="search-page-filters__options">
                {% for editorial_search_browse_producer in editorial_search_browse_producers %}
                  {% assign editorial_search_browse_producer_alias = editorial_search_browse_producer | remove_first: 'The ' | remove: ' Distillery' | remove: ' Brewery' | remove: ' Brewing' | remove: ' Inc.' | remove: ' Inc' | strip %}
                  {% assign editorial_search_browse_producer_tags = editorial_search_browse_producer %}
                  {% if editorial_search_browse_producer_alias != editorial_search_browse_producer %}
                    {% assign editorial_search_browse_producer_tags = editorial_search_browse_producer_tags | append: '~' | append: editorial_search_browse_producer_alias %}
                  {% endif %}
                  {% if editorial_search_browse_producer == 'The Macallan' %}
                    {% assign editorial_search_browse_producer_tags = editorial_search_browse_producer_tags | append: '~Macallan Distillery' %}
                  {% endif %}
                  {% assign editorial_search_browse_id = editorial_search_browse_producer | handleize | prepend: 'SearchBrowse-producer-' %}
                  <div class="search-page-filters__option">
                    <input
                      id="{{ editorial_search_browse_id }}"
                      type="checkbox"
                      class="search-page-filters__checkbox"
                      data-editorial-search-browse-filter
                      data-editorial-search-browse-group-name="producer"
                      data-editorial-search-browse-tags="{{ editorial_search_browse_producer_tags | escape }}"
                      form="SearchPageForm"
                    />
                    <label for="{{ editorial_search_browse_id }}">{{ editorial_search_browse_producer }}</label>
                  </div>
                {% endfor %}
              </div>
            </fieldset>
          </details>
        </div>
      </details>

      <details class="search-page-filters hide">
        <summary class="search-page-filters__summary">
          <span>Other Excluded Sections</span>
        </summary>
        <fieldset class="search-page-filters__content">
          <!--<legend class="visually-hidden">Filter results</legend>-->
          <div class="search-page-filters__group">
            <!--<span class="search-page-filters__group-label">Exclude</span>-->
            <div class="search-page-filters__options">
              {% for editorial_search_filter_tag in editorial_search_filter_tags %}
                {% capture editorial_search_exclusion %}-tag:"{{ editorial_search_filter_tag }}"{% endcapture %}
                {% assign editorial_search_filter_active = false %}
                {% if normalized_search_terms contains editorial_search_exclusion %}
                  {% assign editorial_search_filter_active = true %}
                {% endif %}
                {% assign editorial_search_filter_label = editorial_search_filter_tag | remove: 'Section: ' %}
                {% assign editorial_search_filter_id = editorial_search_filter_label | handleize | prepend: 'SearchExclude-' %}
                <div class="search-page-filters__option">
                  <input
                    id="{{ editorial_search_filter_id }}"
                    type="checkbox"
                    value="{{ editorial_search_filter_tag | escape }}"
                    class="search-page-filters__checkbox"
                    data-editorial-search-filter
                    form="SearchPageForm"
                    {% if editorial_search_filter_active %}checked{% endif %}
                  />
                  <label for="{{ editorial_search_filter_id }}">{{ editorial_search_filter_label }}</label>
                </div>
              {% endfor %}
            </div>
          </div>
        </fieldset>
      </details>
    </aside>

    <div class="search-page-results-column">
      <ul class="list-view-items">
        {% for item in search.results %}
          <li class="list-view-item">
            {% if item.object_type == 'product' %}
              {% render 'product-card-list', product: item %}
            {% else %}
              <div class="product-card product-card--list">
                <a href="{{ item.url }}" class="full-width-link">
                  <span class="visually-hidden">{{ item.title }}</span>
                </a>
                <div class="list-view-item__link">
                  <div class="list-view-item__image-column">
                    <div class="list-view-item__image-wrapper product-card__image-wrapper">
                      {% unless item.image == null %}
                        <img class="list-view-item__image" src="{{ item.image.src | img_url: '600x600' }}" alt="{{ item.image.alt | escape }}">
                      {% endunless %}
                    </div>
                  </div>

                  <div class="list-view-item__title-column">
                    <div class="list-view-item__title" aria-hidden="true">
                      <span class="product-card__title">{{ item.title }}</span>
                    </div>
                    <div>
                      {% if item.published_at %}{{ item.published_at | date: format: "date" }} &#8212; {% endif %}
                      {{ item.content | strip_html | truncate: 200 }}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>

      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    </div>
  </div>
{% endif %}

{% if search.results_count < 2  %}
  <div class="search--less-than-2-results"></div>
{% endif %}

{% endpaginate %}
